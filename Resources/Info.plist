<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleIdentifier</key><string>com.berkaygokce.mystat</string>
    <key>CFBundleName</key><string>mystat</string>
    <key>CFBundleDisplayName</key><string>mystat</string>
    <key>CFBundleExecutable</key><string>mystat</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSUIElement</key><true/>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Wi‑Fi ağının adı (SSID) macOS'ta konum izni ister; yalnızca Ağ bölümündeki "İzin ver" ile sorulur (plan 2e).
         İzin penceresini macOS çizer: metin buradan (İngilizce) ya da sistem diline göre <dil>.lproj/InfoPlist.strings'ten. -->
    <key>NSLocationUsageDescription</key><string>To show the Wi‑Fi network's name. Your location isn't used or stored.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>To show the Wi‑Fi network's name. Your location isn't used or stored.</string>
    <!-- libmalloc serbest bırakılan büyük blokları önbellekte tutar ve ayak izinde sayar (disk taraması bittiğinde
         ~120 MB geri verilmiyordu). Kapalıyken bırakılan bellek hemen sisteme döner (plan 2d, Task 8). -->
    <key>LSEnvironment</key>
    <dict>
        <key>MallocLargeCache</key><string>0</string>
    </dict>
</dict>
</plist>
